{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MALDITOESPEJO Failure Record",
  "type": "object",
  "required": ["failure_id", "run_id", "case_id", "stage", "status", "timestamp", "attempt", "error_type", "message"],
  "properties": {
    "failure_id": {"type": "string", "pattern": "^FAIL-[0-9]{8}$"},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^CASE-[0-9]{8}$"},
    "stage": {"type": "string", "minLength": 1},
    "status": {"enum": ["FAILED", "WAITING_RECOVERY", "RECOVERED", "BLOCKED"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "attempt": {"type": "integer", "minimum": 1},
    "error_type": {"enum": ["SOURCE_UNAVAILABLE", "SEARCH_FAILED", "IMPORT_FAILED", "EVIDENCE_UNAVAILABLE", "VALIDATION_FAILED", "DEPENDENCY_FAILED", "TIMEOUT", "INVALID_INPUT", "UNKNOWN"]},
    "message": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string"},
    "next_action": {"type": "string"},
    "recovered_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
